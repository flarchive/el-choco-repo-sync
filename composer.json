{
  "name": "el-choco/repo-sync",
  "description": "Synchronize GitHub README files with Flarum posts and announce releases in existing discussions.",
  "type": "flarum-extension",
  "license": "MIT",
  "authors": [{"name": "el-choco"}],
  "require": {"php": "^8.3", "ext-json": "*", "flarum/core": "^2.0.2", "guzzlehttp/guzzle": "^7.0"},
  "autoload": {"psr-4": {"ElChoco\\RepoSync\\": "src/"}},
  "extra": {"flarum-extension": {"title": "Repo Sync", "category": "feature", "icon": {"name": "fas fa-sync-alt", "backgroundColor": "#4d698e", "color": "#fff"}}},
  "suggest": {"flarum/markdown": "Render README and release notes as Markdown."},
  "archive": {"exclude": ["/js/node_modules", "/tests", "/dist", "/INSTALL-DE.md"]}
}
